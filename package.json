{
  "name": "doit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "setup:hooks": "node scripts/setup-hooks.js",
    "postinstall": "node scripts/setup-hooks.js",
    "bump:major": "node scripts/bump-version.js major",
    "bump:minor": "node scripts/bump-version.js minor",
    "build": "next build",
    "build:gh-pages": "node scripts/build-gh-pages.js",
    "start": "next start",
    "clean": "rm -rf .next && rm -rf coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:smoke": "playwright test --project=smoke-tests",
    "test:smoke:quick": "playwright test --project=smoke-tests --workers=4",
    "test:smoke:headed": "playwright test --project=smoke-tests --headed",
    "test:visual": "playwright test --project=visual-tests",
    "test:visual:update": "playwright test --project=visual-tests --update-snapshots",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:smoke && npm run test:visual",
    "test:full": "npm run test && npm run test:smoke && npm run test:visual",
    "validate": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:smoke && npm run test:visual"
  },
  "dependencies": {
    "chrono-node": "^2.9.0",
    "dompurify": "^3.3.1",
    "next": "16.0.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  }
}
